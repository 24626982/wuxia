{
  "meta": {
    "title": "劍譜疑雲",
    "script_version": "v1.0（2026-09-17 初版定案）",
    "engine": "Godot",
    "note": "本檔描述流程與判定；台詞在 data/dialogues/*.json。欄位說明見 CODEX_README.md。"
  },
  "flags": {
    "_comment": "所有 effects 鍵。type=enum 時列出可能值。source=codex 表示原本 JSON 已有。",
    "approach": {
      "type": "enum",
      "values": [
        "compassion",
        "justice"
      ],
      "source": "codex",
      "scored": false
    },
    "clue": {
      "type": "enum",
      "values": [
        "whistle",
        "seal"
      ],
      "source": "codex",
      "scored": false
    },
    "trust_guard": {
      "type": "bool",
      "source": "codex",
      "scored": false
    },
    "shen_lead": {
      "type": "enum",
      "values": [
        "sound",
        "marks"
      ],
      "source": "codex"
    },
    "bai_method": {
      "type": "enum",
      "values": [
        "copy",
        "time"
      ],
      "source": "codex"
    },
    "gu_response": {
      "type": "enum",
      "values": [
        "compare",
        "challenge"
      ],
      "source": "codex"
    },
    "residence_resolved": {
      "type": "bool",
      "source": "codex"
    },
    "residence_next_lead": {
      "type": "enum",
      "values": [
        "seal",
        "safety"
      ],
      "source": "codex"
    },
    "explore_*": {
      "type": "string",
      "source": "codex",
      "note": "探索物件已調查過即有值（observe / verify / seen）"
    },
    "ev_seal_sketch": {
      "type": "bool",
      "note": "阿棠畫的竹印（clue=seal 時取得）"
    },
    "met_chen_bai": {
      "type": "bool"
    },
    "n1_result": {
      "type": "enum",
      "values": [
        "talk",
        "fight",
        "tried_then_fight"
      ]
    },
    "n2_result": {
      "type": "enum",
      "values": [
        "talk",
        "fight",
        "tried_then_fight"
      ]
    },
    "n3_result": {
      "type": "enum",
      "values": [
        "talk",
        "fight",
        "tried_then_fight"
      ]
    },
    "n4_result": {
      "type": "enum",
      "values": [
        "talk",
        "fight",
        "tried_then_fight"
      ]
    },
    "n5_result": {
      "type": "enum",
      "values": [
        "talk",
        "fight",
        "tried_then_fight"
      ]
    },
    "xiaoman_safe": {
      "type": "bool"
    },
    "chen_bai_nails": {
      "type": "bool"
    },
    "hide_spot": {
      "type": "bool",
      "note": "知道劍譜藏在北邊竹管"
    },
    "heart_shi_an": {
      "type": "bool"
    },
    "heart_brother": {
      "type": "bool"
    },
    "heart_xiaoman": {
      "type": "bool"
    },
    "heart_shen_he": {
      "type": "bool"
    },
    "e1_boots": {
      "type": "bool"
    },
    "e2_ash": {
      "type": "bool"
    },
    "e3_sheath": {
      "type": "bool"
    },
    "revealed": {
      "type": "bool"
    },
    "suspect_known": {
      "type": "bool"
    },
    "monologue": {
      "type": "enum",
      "values": [
        "shaken",
        "rules",
        "silent"
      ]
    },
    "got_manual": {
      "type": "bool"
    },
    "manual_secured": {
      "type": "bool",
      "note": "N5 對質前選擇先從藏處取回劍譜；知道藏處不等於已取回"
    }
  },
  "derived": {
    "fight_count": "n1_result ~ n5_result 中，值為 fight 或 tried_then_fight 的數量（未設定的不算）",
    "route": {
      "talk": "n1_result ~ n5_result 全部為 talk",
      "fight": "n1_result ~ n5_result 全部為 fight（不含 tried_then_fight）",
      "mixed": "其他"
    }
  },
  "evidence": {
    "_comment": "N3、N5 出示用。requires 成立才出現在選單。",
    "ev_receipt_halves": {
      "label": "兩半收訖單",
      "requires": {
        "residence_resolved": true
      }
    },
    "ev_seal_sketch": {
      "label": "阿棠畫的竹印",
      "requires": {
        "ev_seal_sketch": true
      }
    },
    "ev_pass": {
      "label": "沾血的半張路引（阿棠所述）",
      "requires": {}
    },
    "ev_empty_bed": {
      "label": "小滿的空床",
      "requires": {
        "explore_dormitory_bed": {
          "$exists": true
        }
      }
    },
    "ev_medicine": {
      "label": "白芷窗下的藥包",
      "requires": {
        "bai_method": {
          "$exists": true
        }
      }
    },
    "ev_boots": {
      "label": "釘底靴與真劍",
      "requires": {
        "e1_boots": true
      }
    },
    "ev_ash": {
      "label": "燈座裡的紙灰",
      "requires": {
        "e2_ash": true
      }
    },
    "ev_sheath": {
      "label": "周伯收走的書套",
      "requires": {
        "e3_sheath": true
      }
    }
  },
  "events": [
    {
      "_comment": "序章與西院沿用 Codex 現有流程，不重列。以下為新增或需要觸發條件的事件。"
