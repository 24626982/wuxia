  "node_rules": {
    "choice_types": {
      "correct": "直接成功",
      "valid": "有效項，不扣次數；累積到 success_rule 成立即成功",
      "neutral": "不扣次數，也不算正解",
      "wrong": "錯誤次數 +1",
      "fight": "直接進入戰鬥，結果記 fight"
    },
    "miss_limit": 2,
    "on_third_miss": {
      "line": "對方不想再談了。",
      "options": [
        {
          "label": "出手",
          "result": "tried_then_fight",
          "action": "start_battle"
        },
        {
          "label": "先離開",
          "action": "leave_node",
          "show": "leave_hint",
          "note": "離開後錯誤次數重置；下次進入節點重新開始"
        }
      ]
    },
    "miss_counter": "錯誤次數只在節點內暫存，不寫入 effects",
    "node_shapes": {
      "n1": "標準：四選一找正解",
      "n2": "時間壓力：錯一次巡山弟子前進一格，三格到場（見 nodes.n2.patrol）",
      "n3": "組合：湊齊有效項",
      "n4": "深度：沒有失敗，只有講到哪一層（見 nodes.n4.tiers）",
      "n5": "理＋情，共用耐心"
    },
    "miss_limit_note": "miss_limit 只適用 N1、N3。N2 用 patrol 計數，N4 用 tier 關閉。"
  },
  "nodes": {
    "n1": {
      "map": "dormitory",
      "intro": "n1_intro",
      "prompt": {
        "speaker": "少俠",
        "text": "（要怎麼說？）"
      },
      "choices": [
        {
          "id": "fight",
          "type": "fight",
          "label": "我在查劍譜的事，讓開。"
        },
        {
          "id": "accuse",
          "type": "wrong",
          "label": "小滿是不是拿了劍譜？",
          "reply": [
            {
              "speaker": "石安・西院弟子",
              "text": "你們那邊的人都這麼說。說完了？"
            }
          ]
        },
        {
          "id": "fear",
          "type": "wrong",
          "label": "你怕我拿走東西？",
          "reply": [
            {
              "speaker": "石安・西院弟子",
              "text": "你們要拿，我攔得住嗎？"
            }
          ]
        },
        {
          "id": "bundle",
          "type": "correct",
          "label": "他的包袱周伯收著，我知道。我只看床，你站旁邊看。"
        }
      ],
      "leave_hint": "也許該先弄清楚小滿的東西現在在誰手上。",
      "on_success": {
        "dialogue": "n1_success",
        "effects": {
          "n1_result": "talk"
        }
      },
      "battle": "battle_n1",
      "after_battle": {
        "dialogue": "n1_after_battle"
      }
    },
    "n2": {
      "map": "town",
      "intro": "n2_intro",
      "prompt": {
        "speaker": "少俠",
        "text": "（要怎麼說？）"
      },
      "choices": [
        {
          "id": "fight",
          "type": "fight",
          "label": "（推開他，把他帶離告示板）"
        },
        {
          "id": "bed",
          "type": "correct",
          "label": "你弟弟是小滿吧？他的床我看過，東西都還在，管事的周伯替他收著。我是來找他的。"
        },
        {
          "id": "small_name",
          "type": "neutral",
          "label": "尋人紙上的名字怎麼寫那麼小？",
          "reply": [
            {
              "speaker": "小滿的哥哥",
              "text": "寫大了，你們山上的人會比我先找到他。"
            }
          ]
        },
        {
          "id": "dunno",
          "type": "wrong",
          "label": "我不知道他在哪。你先放手。",
          "reply": [
            {
              "speaker": "小滿的哥哥",
              "text": "每個人都這麼說。"
            }
          ]
        },
        {
          "id": "not_here",
          "type": "wrong",
          "label": "你先放手，這裡不是講話的地方。",
          "reply": [
            {
              "speaker": "小滿的哥哥",
              "text": "那要去哪裡講？你們山上嗎？"
            }
          ]
        }
      ],
      "on_success": {
        "dialogue": "n2_success",
        "effects": {
          "n2_result": "talk"
        }
      },
      "battle": "battle_n2",
      "after_battle": {
        "dialogue": "n2_after_battle"
      },
      "shape": "patrol",
      "patrol": {
        "max": 3,
        "advance_on": [
          "wrong"
        ],
        "steps": [
          null,
          "n2_patrol_1",
          "n2_patrol_2"
        ],
        "on_arrive": {
          "dialogue": "n2_patrol_arrive",
          "choices": [
            {
              "label": "不用了，我自己處理。",
              "dialogue": "n2_patrol_waved_off",
              "action": "reset_patrol",
              "note": "進度歸零可重來；嚴長老在議事廳初訪會提一句"
            },
            {
              "label": "（不說話）",
              "dialogue": "n2_patrol_detained",
              "effects": {
                "n2_result": "talk",
                "n2_patrol": "detained"
              },
              "note": "拿不到 heart_brother，但「東竹亭」仍取得，主線不封死"
            }
          ]
        }
      },
      "battle_note": "戰鬥是把他推離告示板、帶進巷口，不是毆打。戰後設 n2_patrol: avoided。"
    },
    "n3": {
      "map": "bamboo_station",
      "intro": "n3_intro",
      "prompt": {
        "speaker": "少俠",
        "text": "（要怎麼說？可以出示東西，也可以直接說。）"
      },
      "choices": [
        {
          "id": "fight",
          "type": "fight",
