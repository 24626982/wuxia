            },
            "correct_evidence": "ev_sheath",
            "correct_reply": [
              {
                "speaker": "少俠",
                "text": "書套是周伯收走的，他誰都沒講。知道它在那張床上的，只有周伯，和放它的人。"
              }
            ],
            "after_correct": "n5_reason_q3_correct"
