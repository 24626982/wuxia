      "talk": "n1_result ~ n5_result 全部為 talk",
      "fight": "n1_result ~ n5_result 全部為 fight（不含 tried_then_fight）",
      "mixed": "其他"
    },
    "heart_count": "heart_shi_an / heart_brother / heart_xiaoman / heart_shen_he 中為 true 的數量；N5 情段用"
  },
