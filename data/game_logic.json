        "n3_result": {
          "$exists": false
        }
      }
    },
    {
      "id": "n1",
      "map": "dormitory",
      "npc": "shi_an",
      "node": "n1",
      "requires": {
        "residence_resolved": true,
        "n1_result": {
          "$exists": false
        }
      }
    },
    {
      "id": "n2",
      "map": "town",
      "npc": "brother",
      "node": "n2",
      "requires": {
        "explore_town_notice": {
          "$exists": true
        },
        "n1_result": {
          "$exists": true
        },
        "n2_result": {
          "$exists": false
        }
      }
    },
    {
      "id": "n3",
      "map": "bamboo_station",
      "trigger": "third_lamp_at_night",
      "node": "n3",
      "requires": {
        "residence_resolved": true,
        "n1_result": {
          "$exists": true
        },
        "n2_result": {
          "$exists": true
        },
        "n3_result": {
          "$exists": false
        }
      }
    },
    {
      "id": "act3_chen_bai_nails",
      "map": "dormitory",
      "npc": "chen_bai",
      "dialogue": "act3_chen_bai_nails",
      "requires": {
        "n3_result": {
          "$exists": true
        },
        "chen_bai_nails": {
          "$exists": false
        }
      },
      "note": "N3 結束後，下次進宿舍自動觸發"
    },
    {
      "id": "n4",
      "map": "wind_cliff",
      "trigger": "enter_at_night",
      "node": "n4",
      "requires": {
        "chen_bai_nails": true,
        "n4_result": {
          "$exists": false
        }
      }
    },
    {
      "id": "cliff_night_empty",
      "map": "wind_cliff",
      "trigger": "enter_at_night",
      "dialogue": "cliff_night_empty",
      "requires": {
        "n4_result": {
          "$in": [
            "fight",
            "tried_then_fight"
          ]
        }
      }
    },
    {
      "id": "cliff_search",
      "map": "wind_cliff",
      "trigger": "interact_tubes",
      "puzzle": "cliff_search",
      "requires": {
        "chen_bai_nails": true,
        "explore_wind_cliff_record": {
          "$exists": true
        },
        "hide_spot": {
          "$exists": false
        }
      }
    },
    {
      "id": "hall_revisit",
      "map": "hall",
      "trigger": "enter",
      "sequence": [
        "hall_revisit_intro",
        "hall_revisit_roster",
        "hall_revisit_lamp",
        "hall_revisit_allocation",
        "hall_revisit_gu_heng",
        "hall_revisit_uncle_zhou",
        "hall_revisit_monologue"
      ],
      "optional": [
        "hall_revisit_bai_zhi"
      ],
      "requires": {
        "n4_result": {
          "$exists": true
        },
        "revealed": {
          "$exists": false
        }
      },
      "note": "roster / lamp / allocation 可做成三個調查點，全部看完才接顧衡、周伯、獨白"
    },
    {
      "id": "n5",
      "map": "wind_cliff",
      "trigger": "enter",
      "node": "n5",
      "requires": {
        "suspect_known": true,
        "monologue": {
          "$exists": true
        },
        "n5_result": {
          "$exists": false
        }
      }
    },
    {
      "id": "finale",
      "map": "hall",
      "trigger": "enter",
      "sequence": [
        "finale_report"
      ],
      "then": {
        "map": "courtyard",
        "sequence": [
          "finale_courtyard",
          "finale_monologue",
          "@ending"
        ]
      },
      "requires": {
        "n5_result": {
          "$exists": true
        }
      }
    }
  ],
  "map_interactables": {
    "_comment": "初訪就可互動的元件。dialogue 來自 exploration.json。",
    "hall": [
      "explore_hall_record",
      "explore_hall_lamp",
      "explore_hall_ledger",
      "npc_elder_yan"
    ],
    "town": [
      "explore_town_notice",
      "explore_town_parcel",
      "npc_town_vendor",
      "npc_town_tea"
    ],
    "dormitory": [
      {
        "id": "explore_dormitory_bed",
        "enabled_by": "n1 結束（對話或戰鬥）"
      },
      {
        "id": "explore_dormitory_pouch",
        "enabled_by": "n1 結束（對話或戰鬥）"
      }
    ],
    "bamboo_station": [
      "explore_bamboo_station_record",
      "explore_bamboo_station_signal",
      "explore_station_backdoor",
      {
        "id": "npc_station_keeper",
        "requires": {
          "n3_result": {
            "$nin": [
              "fight",
              "tried_then_fight"
            ]
          }
        }
      },
      {
        "id": "npc_station_keeper_closed",
        "requires": {
          "n3_result": {
            "$in": [
              "fight",
              "tried_then_fight"
            ]
          }
        }
      }
    ],
    "wind_cliff": [
      "explore_wind_cliff_record",
      "explore_wind_cliff_signal",
      "npc_herb_elder",
      "explore_cliff_rock"
    ]
  },
  "node_rules": {
    "choice_types": {
      "correct": "直接成功",
      "valid": "有效項，不扣次數；累積到 success_rule 成立即成功",
      "neutral": "不扣次數",
      "wrong": "錯誤次數 +1",
      "fight": "直接進入戰鬥，結果記 fight"
    },
    "miss_limit": 2,
    "on_third_miss": {
      "line": "對方不想再談了。",
      "options": [
        {
          "label": "出手",
          "result": "tried_then_fight",
          "action": "start_battle"
        },
        {
          "label": "先離開",
          "action": "leave_node",
          "show": "leave_hint",
          "note": "離開後錯誤次數重置；下次進入節點重新開始"
        }
      ]
    },
    "miss_counter": "錯誤次數只在節點內暫存，不寫入 effects"
  },
  "nodes": {
    "n1": {
      "map": "dormitory",
      "intro": "n1_intro",
      "prompt": {
        "speaker": "少俠",
        "text": "（要怎麼說？）"
      },
      "choices": [
        {
          "id": "fight",
          "type": "fight",
          "label": "我在查劍譜的事，讓開。"
        },
        {
          "id": "accuse",
          "type": "wrong",
          "label": "小滿是不是拿了劍譜？",
          "reply": [
            {
              "speaker": "石安・西院弟子",
              "text": "你們那邊的人都這麼說。說完了？"
            }
          ]
        },
        {
          "id": "fear",
          "type": "wrong",
          "label": "你怕我拿走東西？",
          "reply": [
            {
              "speaker": "石安・西院弟子",
              "text": "你們要拿，我攔得住嗎？"
            }
          ]
        },
        {
          "id": "bundle",
          "type": "correct",
          "label": "他的包袱周伯收著，我知道。我只看床，你站旁邊看。"
        }
      ],
      "leave_hint": "也許該先弄清楚小滿的東西現在在誰手上。",
      "on_success": {
        "dialogue": "n1_success",
        "effects": {
          "n1_result": "talk"
        }
      },
      "battle": "battle_n1",
      "after_battle": {
        "dialogue": "n1_after_battle"
      }
    },
    "n2": {
      "map": "town",
      "intro": "n2_intro",
      "prompt": {
        "speaker": "少俠",
        "text": "（要怎麼說？）"
      },
      "choices": [
        {
          "id": "fight",
          "type": "fight",
          "label": "放手。"
        },
        {
          "id": "small_name",
          "type": "neutral",
          "label": "尋人紙上的名字怎麼寫那麼小？",
          "reply": [
            {
              "speaker": "小滿的哥哥",
              "text": "寫大了，你們山上的人會比我先找到他。"
            }
          ]
        },
        {
          "id": "dunno",
          "type": "wrong",
          "label": "我不知道他在哪。你先放手。",
          "reply": [
            {
              "speaker": "小滿的哥哥",
              "text": "每個人都這麼說。"
            }
          ]
        },
        {
          "id": "bed",
          "type": "correct",
          "requires": {
            "explore_dormitory_bed": {
              "$exists": true
            }
          },
          "label": "你弟弟是小滿吧？他的床我看過，東西都還在，管事的周伯替他收著。我是來找他的。"
        }
      ],
      "leave_hint": "也許該先去看看小滿住的地方。",
      "on_success": {
        "dialogue": "n2_success",
        "effects": {
          "n2_result": "talk"
        }
      },
      "battle": "battle_n2",
      "after_battle": {
        "dialogue": "n2_after_battle"
      }
    },
    "n3": {
      "map": "bamboo_station",
      "intro": "n3_intro",
      "prompt": {
        "speaker": "少俠",
        "text": "（要怎麼說？可以出示東西，也可以直接說。）"
      },
      "choices": [
        {
          "id": "fight",
          "type": "fight",
          "label": "小滿在裡面吧。叫他出來。"
        },
        {
          "id": "receipt",
          "type": "valid",
          "label": "出示：兩半收訖單",
          "evidence": "ev_receipt_halves",
          "reply": [
            {
              "speaker": "石安・西院弟子",
              "text": "這是寄東西的單子，跟劍譜沒關係。"
            }
          ]
        },
        {
          "id": "seal",
          "type": "wrong",
          "label": "出示：阿棠畫的竹印",
          "evidence": "ev_seal_sketch",
          "reply": [
            {
              "speaker": "石安・西院弟子",
              "text": "你拿這個來，是要抓他？"
            }
          ]
        },
        {
          "id": "brother",
          "type": "valid",
          "label": "他哥哥在鎮上貼尋人紙，貼了好幾天。",
          "requires": {
            "heart_brother": true
          },
          "reply": [
            {
              "speaker": "旁白",
              "text": "石安的手鬆了一下。"
            }
          ]
        },
        {
          "id": "intent",
          "type": "valid",
          "label": "我不是來抓他的，我要確認他沒事。",
          "reply": [
            {
              "speaker": "石安・西院弟子",
              "text": "……光用說的，誰都會說。"
            }
          ]
        }
      ],
      "success_rule": {
        "if": {
          "n1_result": "talk"
        },
        "then": {
          "all_of": [
            "intent"
          ],
          "any_of": [
            "receipt",
            "brother"
          ]
        },
        "else": {
          "all_of": [
            "intent",
            "receipt",
            "brother"
          ]
        }
      },
      "leave_hint": "也許該弄清楚他們在這裡等的是什麼。",
      "leave_hint_when_impossible": {
        "when": {
          "n1_result": {
            "$in": [
              "fight",
              "tried_then_fight"
            ]
          },
          "heart_brother": {
            "$exists": false
          }
        },
        "text": "石安不打算再聽你說了。"
      },
      "on_success": {
        "dialogue": "n3_success",
        "effects": {
          "n3_result": "talk"
        }
      },
      "battle": "battle_n3",
      "after_battle": {
        "dialogue": "n3_after_battle"
      }
    },
    "n4": {
      "map": "wind_cliff",
      "intro": "n4_intro",
      "prompt": {
        "speaker": "少俠",
        "text": "（要怎麼說？）"
      },
      "choices": [
        {
          "id": "fight",
          "type": "fight",
          "label": "你們半夜在這裡做什麼？跟我去見掌門。"
        },
        {
          "id": "manual",
          "type": "wrong",
          "label": "劍譜是不是在你們這裡？",
          "reply": [
            {
              "speaker": "沈禾・修橋學徒",
              "text": "我們要是拿得到劍譜，還用得著拿木頭在這裡吹風？"
            }
          ]
        },
        {
          "id": "steal",
          "type": "wrong",
          "label": "你們在偷學？",
          "reply": [
            {
              "speaker": "沈禾・修橋學徒",
              "text": "你要這樣說也行。"
            }
          ]
        },
        {
          "id": "signals",
          "type": "correct",
          "label": "竹管是傳聲用的。那天橋下的兩聲，是小滿在叫人會合；天亮那三聲，是在叫人去救陳白。",
          "requires": {
            "shen_lead": {
              "$exists": true
            },
            "explore_wind_cliff_record": {
              "$exists": true
            }
          }
        }
      ],
      "leave_hint": "橋下的兩聲和天亮的三聲，也許不是同一個意思。",
      "on_success": {
        "dialogue": "n4_success",
        "effects": {
          "n4_result": "talk"
        }
      },
      "battle": "battle_n4",
      "after_battle": {
        "dialogue": "n4_after_battle"
      }
    },
    "n5": {
      "map": "wind_cliff",
      "search_prompt": {
        "speaker": "少俠",
        "text": "（避風石後面那幾根竹管，還沒查過。要先搜一遍嗎？上了崖就沒有回頭的機會。）"
      },
      "search_choices": [
        {
          "id": "search",
          "label": "先搜查竹管，再與嚴承對質。"
        },
        {
          "id": "skip",
          "label": "不搜了，直接上前對質。"
        }
      ],
      "retrieval_prompt": {
        "speaker": "少俠",
        "text": "已知道劍譜藏在北邊竹管。要先取回，再與嚴承對質嗎？"
      },
      "retrieval_choices": [
        {
          "id": "retrieve",
          "label": "先取回劍譜，再與嚴承對質。"
        },
        {
          "id": "defer",
          "label": "先與嚴承對質，暫不取走劍譜。"
        }
      ],
      "intro": "n5_intro",
      "prompt": {
        "speaker": "少俠",
        "text": "（要動手，還是跟他談？）"
      },
      "entry_choices": [
        {
          "id": "fight",
          "type": "fight",
          "label": "動手。"
        },
        {
          "id": "talk",
          "type": "start_talk",
